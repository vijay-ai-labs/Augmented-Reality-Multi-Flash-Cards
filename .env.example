# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Nothing here is needed for local development. `npm run dev` and
# `npm run preview` serve assets/ straight from the project root, so an empty
# VITE_ASSET_BASE is correct on this machine. These values exist for the two
# jobs that talk to the CDN: uploading the library, and checking it.


# --- The app ----------------------------------------------------------------

# Public base URL of the asset library, with NO trailing path and NO trailing
# slash. The bucket must hold the literal "assets/" folder at its root, because
# manifest.json stores card paths as "assets/models/<deck>/<card>.glb" and
# src/config.js joins them onto this base unchanged.
#
# Leave EMPTY for local work. Set it in the Vercel project's environment
# variables for a deploy, then redeploy — Vite inlines this at build time, so
# adding the variable without a rebuild changes nothing.
#
# Cloudflare's r2.dev URL looks like:
#   https://pub-<32 hex chars>.r2.dev
# It is rate-limited and Cloudflare states it is not for production. Fine to
# launch on, worth replacing with a custom domain once you have one.
VITE_ASSET_BASE=


# --- Uploading to R2 (npm run upload) ---------------------------------------

# Read by tools/upload-assets.mjs only. Never reaches the browser: Vite exposes
# a variable to client code only when its name starts with VITE_, so these stay
# server-side even though they sit in the same file.

# Cloudflare account ID, from the R2 page of the dashboard.
R2_ACCOUNT_ID=

# R2 API token credentials. Create the token under R2 > API > Manage API
# Tokens, with "Object Read & Write" scoped to this one bucket. The secret is
# shown once at creation and never again.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name, as typed when you created it.
R2_BUCKET=ar-flashcards-assets
