# Normalize line endings: LF in the repo, native in the working tree.
* text=auto

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binaries — never touch, never diff.
*.glb   binary
*.mind  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.mp3   binary
*.m4a   binary
*.ogg   binary
*.wav   binary
*.wasm  binary
